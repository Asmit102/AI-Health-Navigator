# Server Port
PORT=4001

# MongoDB Connection String (e.g. MongoDB Atlas cluster URI)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Frontend Client URL for CORS (optional in dev, recommended in production e.g. https://your-app.vercel.app)
CLIENT_URL=http://localhost:5173
